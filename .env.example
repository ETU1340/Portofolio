# PostgreSQL (docker-compose)
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio_secret
POSTGRES_DB=portfolio
POSTGRES_PORT=5432

# API (copy to api/.env)
DATABASE_URL=postgresql://portfolio:portfolio_secret@localhost:5432/portfolio?schema=public
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
ADMIN_EMAIL=admin@portfolio.local
ADMIN_PASSWORD=Admin123!
CORS_ORIGIN=http://localhost:3000
PORT=4000
NODE_ENV=development

# Web (copy to web/.env.local)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CV_URL=
NEXT_PUBLIC_GITHUB_URL=https://github.com
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com
API_INTERNAL_URL=http://localhost:4000
